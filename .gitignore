# Python
__pycache__/
*.py[cod]
*.pyo
*.egg-info/
dist/
build/

# Virtual environment
venv/
.venv/

# Environment variables
.env

# Data — all of it is re-fetchable from the Elia and Open-Meteo APIs, so the
# caches and derived feature tables stay out of version control. Anchored with
# a leading slash: an unanchored "data/" also matches src/data/ and would
# silently exclude pipeline source code.
/data/

# Models — trained artefacts, reproducible from the pipeline. Anchored so it
# does not also swallow src/models/.
/models/

# Logs
/logs/

# Notebooks
notebooks/.ipynb_checkpoints/

# IDE
.vscode/
.idea/

# OS
Thumbs.db
.DS_Store

# Jupyter
.ipynb_checkpoints/

# Reports
/reports/

# Experiments
/experiments/

# Streamlit
.streamlit/
